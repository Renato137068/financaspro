    },
    "/transactions": {
      "get": {
        "tags": [
          "transactions"
        ],
        "summary": "Listar transactions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      },
      "post": {
        "tags": [
          "transactions"
        ],
        "summary": "Criar transactions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "receita",
                      "despesa",
                      "transferencia"
                    ]
                  },
                  "amount": {
                    "type": "number",
                    "maximum": 999999999999.99,
                    "exclusiveMinimum": 0
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "subcategory": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "accountId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "targetAccountId": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "maxItems": 10,
                    "default": []
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000,
                    "nullable": true
                  },
                  "recurring": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "type",
                  "amount",
                  "description",
                  "category",
                  "date"
                ]
              }
            }
          }
        }
      }
    },
