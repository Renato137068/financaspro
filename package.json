{
  "name": "financaspro-v11",
  "version": "11.3.19",
  "description": "FinançasPro — SaaS de Finanças Pessoais",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "test": "npm run test:frontend:unit",
    "test:frontend:unit": "node node_modules/jest/bin/jest.js --config jest.frontend.config.cjs",
    "test:watch": "node node_modules/jest/bin/jest.js --config jest.frontend.config.cjs --watch",
    "test:coverage": "node node_modules/jest/bin/jest.js --config jest.frontend.config.cjs --coverage",
    "test:ci": "node scripts/check-version-alignment.cjs && node node_modules/jest/bin/jest.js --config jest.frontend.config.cjs --ci --coverage && node scripts/check-xss-sinks.cjs && node scripts/check-contrast.cjs && node scripts/check-css-tokens.cjs && node scripts/extrato-perf-gate.cjs && node scripts/persona-g-10k.cjs",
    "test:bench:extrato": "node scripts/extrato-perf-gate.cjs",
    "test:audit:persona-g": "node scripts/persona-g-10k.cjs",
    "test:unit": "npm run test",
    "test:open-coverage": "npm run test:coverage && start coverage/frontend/lcov-report/index.html",
    "lint": "eslint js/",
    "lint:strict": "eslint js/ --max-warnings 0",
    "lint:changed": "node scripts/lint-changed.cjs",
    "check:globals": "node scripts/generate-frontend-globals.cjs --check",
    "globals:update": "node scripts/generate-frontend-globals.cjs",
    "check:telas": "node scripts/generate-telas.cjs --check",
    "telas:gerar": "node scripts/generate-telas.cjs",
    "auditorias:indice": "node scripts/gerar-indice-auditorias.cjs",
    "check:auditorias": "node scripts/gerar-indice-auditorias.cjs --check",
    "security:xss": "node scripts/check-xss-sinks.cjs",
    "test:db": "supabase test db",
    "test:db:ci": "node scripts/test-supabase-pgtap.cjs",
    "test:edge": "node scripts/test-edge.cjs",
    "check:edge-types": "node scripts/test-edge.cjs --tipos",
    "dev": "vite",
    "dev:legacy": "http-server . -p 3000 -g",
    "build": "node scripts/inject-supabase-env.cjs && node scripts/setup-fonts.cjs && vite build --config vite.config.cjs && node scripts/copy-static.cjs && node scripts/harden-csp.cjs && node scripts/sourcemaps-guardar.cjs && node scripts/check-dist-orphans.cjs",
    "check:bundle": "node scripts/check-bundle-budget.cjs",
    "erro:pilha": "node scripts/erro-pilha.cjs",
    "check:version": "node scripts/check-version-alignment.cjs",
    "versao:subir": "node scripts/subir-versao.cjs",
    "check:pre-beta": "node scripts/pre-beta-check.cjs",
    "check:pre-beta:static": "node scripts/pre-beta-check.cjs",
    "check:billing": "node scripts/check-billing-wiring.cjs",
    "test:report": "node scripts/test-report.cjs",
    "check:bundle:report": "node scripts/check-bundle-budget.cjs --report",
    "build:analyze": "vite build --config vite.config.cjs --mode analyze",
    "preview": "vite preview",
    "start": "node scripts/servidor-local.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "vendor:sync": "node scripts/sync-vendor.cjs",
    "postinstall": "node scripts/sync-vendor.cjs",
    "icons:generate": "node scripts/generate-icons.cjs",
    "play-assets:generate": "node scripts/generate-play-assets.cjs",
    "screenshots:capture": "node scripts/capture-screenshots.cjs",
    "vitrine:gerar": "node scripts/gerar-vitrine-play.cjs",
    "check:ficha": "node scripts/play-ficha.cjs",
    "test:e2e": "playwright test --config playwright.config.cjs",
    "test:e2e:smoke": "playwright test --config playwright.config.cjs e2e/smoke-boot.spec.cjs e2e/onboarding-primeiro-cta.spec.cjs e2e/billing-smoke.spec.cjs",
    "test:e2e:anual": "playwright test --config playwright.config.cjs e2e/persistencia-anual.spec.cjs",
    "test:e2e:caminho": "playwright test --config playwright.config.cjs e2e/caminho-do-dinheiro.spec.cjs",
    "test:a11y": "playwright test --config playwright.config.cjs accessibility.spec.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:release": "npm run android:sync && node scripts/android-release.cjs",
    "android:bundle": "npm run android:sync && node scripts/android-bundle.cjs",
    "android:bundle:local": "node scripts/set-build-mode.cjs local && npm run android:bundle && node scripts/set-build-mode.cjs cloud",
    "build:mode:local": "node scripts/set-build-mode.cjs local",
    "build:mode:cloud": "node scripts/set-build-mode.cjs cloud",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:add": "npx cap add ios",
    "check:contrast": "node scripts/check-contrast.cjs",
    "check:a11y": "node scripts/check-contrast.cjs && npm run test:frontend:unit -- tests/a11y-static.test.js",
    "check:css": "node scripts/check-css-tokens.cjs",
    "check:css:update": "node scripts/check-css-tokens.cjs --update",
    "css:tokenize": "node scripts/css-hex-to-token.cjs",
    "fonts": "node scripts/setup-fonts.cjs",
    "start:dist": "node scripts/servidor-local.cjs --dist",
    "check:dist": "node scripts/check-dist-orphans.cjs"
  },
  "keywords": [
    "finanças",
    "pessoais",
    "saas",
    "pwa",
    "javascript"
  ],
  "author": "Renato José Soares",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.6.11",
    "@supabase/supabase-js": "^2.117.2",
    "lucide": "^1.14.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.10.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "otplib": "^12.0.1",
    "playwright": "^1.63.0",
    "prisma": "^5.22.0",
    "sharp": "^0.35.0",
    "supabase": "^2.116.0",
    "terser": "^5.24.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "postcss": "^8.5.18",
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}
