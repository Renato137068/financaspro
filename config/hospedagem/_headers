# Cabeçalhos da versão web em hospedagem estática.
#
# Formato do Cloudflare Pages (recomendado) e do Netlify, que leem este arquivo
# na raiz do que é publicado: scripts/copy-static.cjs o copia para dist/_headers.
# Substitui o que o servidor Express mandava (helmet e as regras de cache),
# que saiu do projeto (ADR 0007). Passo a passo em docs/release/hospedagem-web.md.
#
# A CSP de conteúdo continua no <meta> do index.html (scripts/harden-csp.cjs e
# csp-connect-src.cjs a ajustam no build). Aqui fica só o que <meta> não faz:
# frame-ancestors, que impede outro site de abrir o app num iframe.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Ponto de entrada: descobre os arquivos novos a cada versão. Cache longo aqui
# prenderia o usuário numa versão antiga.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache

# Só arquivos com hash no nome: mudar o conteúdo muda o nome.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable

# js/ mistura arquivos com hash (chunks) e sem (app.bundle.js,
# vendor.bundle.js, pin-guard.js): uma hora, como o Express fazia.
/js/*
  Cache-Control: public, max-age=3600

# App Links do Android: o Google exige JSON, sem redirecionamento.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Página do app e artigos (site/ no repositório): CSS e imagens sem hash no
# nome, então um dia de cache, não um ano.
/site/*
  Cache-Control: public, max-age=86400
